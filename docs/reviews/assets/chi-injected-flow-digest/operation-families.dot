digraph chi_operation_families {
  graph [
    rankdir=LR,
    bgcolor="#f7f9fc",
    pad=0.25,
    nodesep=0.35,
    ranksep=0.75,
    fontname="Noto Sans CJK SC",
    label="输入摘录基线 b4e5aba · 非实时实现状态\nCHI operation families：opcode-specific effect 由可复用原语组合",
    labelloc=t,
    fontsize=20
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#486581",
    fillcolor="#ffffff",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    margin="0.12,0.08"
  ];
  edge [
    color="#627d98",
    fontcolor="#334e68",
    fontname="Noto Sans CJK SC",
    fontsize=9,
    arrowsize=0.7
  ];

  subgraph cluster_families {
    label="Operation intent（输入资料 1–44）";
    color="#bcccdc";
    style="rounded";

    family_matrix [
      shape=plain,
      label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
          <TR>
            <TD BGCOLOR="#D9E2EC"><B>Family</B></TD>
            <TD BGCOLOR="#D9E2EC"><B>Corr</B></TD>
            <TD BGCOLOR="#D9E2EC"><B>Data</B></TD>
            <TD BGCOLOR="#D9E2EC"><B>Snoop</B></TD>
            <TD BGCOLOR="#D9E2EC"><B>Fanout</B></TD>
            <TD BGCOLOR="#D9E2EC"><B>Authority</B></TD>
            <TD BGCOLOR="#D9E2EC"><B>Complete</B></TD>
          </TR>
          <TR><TD BGCOLOR="#E3F8FF">Read</TD><TD>yes</TD><TD>yes</TD><TD>profile</TD><TD>-</TD><TD>yes</TD><TD>yes</TD></TR>
          <TR><TD BGCOLOR="#FFF3C4">Write / CopyBack</TD><TD>yes</TD><TD>yes</TD><TD>profile</TD><TD>-</TD><TD>yes</TD><TD>yes</TD></TR>
          <TR><TD BGCOLOR="#E3FCEC">Dataless / CMO / Stash</TD><TD>yes</TD><TD>dirty</TD><TD>profile</TD><TD>profile</TD><TD>yes</TD><TD>yes</TD></TR>
          <TR><TD BGCOLOR="#F3E8FF">Atomic</TD><TD>yes</TD><TD>yes</TD><TD>coherent</TD><TD>-</TD><TD>yes</TD><TD>yes</TD></TR>
          <TR><TD BGCOLOR="#F3E8FF">DVM</TD><TD>yes</TD><TD>-</TD><TD>-</TD><TD>yes</TD><TD>-</TD><TD>yes</TD></TR>
        </TABLE>
      >
    ];
    compose [
      shape=diamond,
      fillcolor="#ffffff",
      label="按 profile\n选择原语"
    ];
    family_matrix -> compose;
  }

  subgraph cluster_methods {
    label="可复用基本方法";
    color="#9fb3c8";
    style="rounded";

    correlation [
      label="Route + correlation\nNodeID · TxnID · DBID\nrequest / response identity"
    ];
    data_plan [
      label="Data plan\nsource · forwarding · merge\nBE · PassDirty · multi-packet"
    ];
    snoop [
      label="Snoop effect\nselect · fanout · aggregate\ninvalidate / downgrade / retain"
    ];
    fanout [
      label="System fanout / join\ntarget set · per-target correlation\nbarrier / early completion"
    ];
    authority [
      label="Coherence authority\ncache permission · directory holder\noperation-specific final state"
    ];
    residency [
      label="Snoop-domain clean residency\nallocation intent · clean-copy disposition\ncapacity/replacement separately scoped"
    ];
    backing [
      label="Reference backing authority\nprepare · version guard · commit\nindependent of clean residency"
    ];
    completion [
      label="Completion contract\nreceipt · data · Comp\nCompAck · persistence point"
    ];

    residency -> backing [
      dir=none,
      style=dashed,
      color="#d64545",
      fontcolor="#8a1c1c",
      label="独立状态轴"
    ];
  }

  subgraph cluster_results {
    label="Operation-specific result";
    color="#bcccdc";
    style="rounded";

    payload_result [
      fillcolor="#e3f8ff",
      label="Payload result\nnone / old / new / merged\nsingle dirty-responsibility transfer"
    ];
    permission_result [
      fillcolor="#e3fcec",
      label="Authority result\nI / S / U (+ clean/dirty)\nrequester / peer / stash / nobody"
    ];
    residency_result [
      fillcolor="#e3fcec",
      label="Residency result\nnone / retained clean copy\ninside Snoop domain"
    ];
    backing_result [
      fillcolor="#f3e8ff",
      label="Reference backing result\nunchanged / committed\nnot implied by residency"
    ];
    observation_result [
      fillcolor="#fff3c4",
      label="Observation result\naccepted ≠ data complete\n≠ acknowledged ≠ persistent"
    ];
  }

  compose -> correlation;
  compose -> data_plan;
  compose -> snoop;
  compose -> fanout;
  compose -> authority;
  compose -> residency;
  compose -> backing;
  compose -> completion;

  data_plan -> payload_result;
  snoop -> payload_result [label="dirty data"];
  snoop -> permission_result;
  fanout -> observation_result [label="join/barrier"];
  authority -> permission_result;
  residency -> residency_result;
  backing -> backing_result;
  correlation -> observation_result;
  completion -> observation_result;

  boundary [
    shape=note,
    style="filled",
    color="#d64545",
    fillcolor="#fff5f5",
    fontcolor="#8a1c1c",
    label="复用 ≠ 自动完备\n新增 opcode 仍需 eligibility、phase、\nfinal state、feature/flow 与 witness"
  ];
  observation_result -> boundary [style=dashed, color="#d64545"];

  subgraph cluster_write_evict_mapping {
    label="后续规范裁决 / 建模映射更新 · WriteEvictFull 首个 CAH=0 分支";
    color="#f0b429";
    style="rounded,dashed";

    write_evict_req [
      fillcolor="#fff3c4",
      label="WriteEvictFull REQ\n显式选择 resident UC line\nAllocate · CAH=0"
    ];
    write_evict_dbid [
      fillcolor="#ffffff",
      label="CompDBIDResp\noriginal TxnID → Home DBID\nRN consumes RSP: original TxnID reusable"
    ];
    write_evict_dat [
      fillcolor="#e3f8ff",
      label="CopyBackWrData_UC\none full clean line"
    ];
    write_evict_rn [
      fillcolor="#e3fcec",
      label="RN authority result\nUC → I"
    ];
    write_evict_residency [
      fillcolor="#e3fcec",
      label="Snoop-domain result\ncoherence-domain authority required\nretain clean resident copy"
    ];
    write_evict_backing [
      fillcolor="#f3e8ff",
      label="Reference backing result\npayload/version unchanged\nno backing commit"
    ];
    write_evict_boundary [
      shape=note,
      style="filled",
      color="#d64545",
      fillcolor="#fff5f5",
      fontcolor="#8a1c1c",
      label="本映射不作为实现状态证明\n未覆盖 victim/replacement policy · CAH=1\nsame-line Snoop · WriteEvictOrEvict"
    ];

    write_evict_req -> write_evict_dbid -> write_evict_dat;
    write_evict_dbid -> write_evict_rn [label="emit DAT + retire"];
    write_evict_dat -> write_evict_residency [label="clean allocation"];
    write_evict_dat -> write_evict_backing [
      style=dashed,
      color="#805ad5",
      fontcolor="#553c9a",
      label="does not commit"
    ];
    write_evict_backing -> write_evict_boundary [
      style=dotted,
      arrowhead=none,
      color="#d64545"
    ];
  }

}
