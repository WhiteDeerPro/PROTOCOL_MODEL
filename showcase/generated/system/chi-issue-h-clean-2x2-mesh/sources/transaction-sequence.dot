digraph chi_clean_sequence {
  rankdir=TB;
  graph [bgcolor="white", pad=0.45, nodesep=0.88, ranksep=0.63, splines=polyline, outputorder=edgesfirst, labelloc="t", label="Clean ReadUnique · participant sequence", fontname="sans-serif", fontsize=18];
  node [fontname="sans-serif", fontsize=10];
  edge [fontname="sans-serif", fontsize=9, arrowsize=0.72, penwidth=1.8];
  h_rn0 [shape=box, group="rn0", style="rounded,filled", fillcolor="#e0f2fe", color="#0284c7", label="RN0\nrequester"];
  h_hn0 [shape=box, group="hn0", style="rounded,filled", fillcolor="#ffedd5", color="#ea580c", label="HN0\nHome"];
  h_rn1 [shape=box, group="rn1", style="rounded,filled", fillcolor="#e0f2fe", color="#0284c7", label="RN1\nsnoopee"];
  h_rn2 [shape=box, group="rn2", style="rounded,filled", fillcolor="#e0f2fe", color="#0284c7", label="RN2\nsnoopee"];
  { rank=same; h_rn0; h_hn0; h_rn1; h_rn2; }
  h_rn0 -> h_hn0 -> h_rn1 -> h_rn2 [style=invis, weight=100];
  e1_rn0 [shape=point, group="rn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e1_hn0 [shape=point, group="hn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e1_rn1 [shape=point, group="rn1", width=0.055, height=0.055, label="", color="#94a3b8"];
  e1_rn2 [shape=point, group="rn2", width=0.055, height=0.055, label="", color="#94a3b8"];
  { rank=same; e1_rn0; e1_hn0; e1_rn1; e1_rn2; }
  e1_rn0 -> e1_hn0 -> e1_rn1 -> e1_rn2 [style=invis, weight=100];
  e1_rn0 -> e1_hn0 [constraint=false, color="#2563eb", fontcolor="#2563eb", xlabel="ReadUnique\nRN0 → XP00 → XP10 → XP11 → HN0"];
  e2_rn0 [shape=point, group="rn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e2_hn0 [shape=point, group="hn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e2_rn1 [shape=point, group="rn1", width=0.055, height=0.055, label="", color="#94a3b8"];
  e2_rn2 [shape=point, group="rn2", width=0.055, height=0.055, label="", color="#94a3b8"];
  { rank=same; e2_rn0; e2_hn0; e2_rn1; e2_rn2; }
  e2_rn0 -> e2_hn0 -> e2_rn1 -> e2_rn2 [style=invis, weight=100];
  e2_hn0 -> e2_rn1 [constraint=false, color="#059669", fontcolor="#059669", xlabel="SnpUnique\nHN0 → XP11 → XP10 → RN1"];
  e3_rn0 [shape=point, group="rn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e3_hn0 [shape=point, group="hn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e3_rn1 [shape=point, group="rn1", width=0.055, height=0.055, label="", color="#94a3b8"];
  e3_rn2 [shape=point, group="rn2", width=0.055, height=0.055, label="", color="#94a3b8"];
  { rank=same; e3_rn0; e3_hn0; e3_rn1; e3_rn2; }
  e3_rn0 -> e3_hn0 -> e3_rn1 -> e3_rn2 [style=invis, weight=100];
  e3_hn0 -> e3_rn2 [constraint=false, color="#059669", fontcolor="#059669", xlabel="SnpUnique\nHN0 → XP11 → XP01 → RN2"];
  e4_rn0 [shape=point, group="rn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e4_hn0 [shape=point, group="hn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e4_rn1 [shape=point, group="rn1", width=0.055, height=0.055, label="", color="#94a3b8"];
  e4_rn2 [shape=point, group="rn2", width=0.055, height=0.055, label="", color="#94a3b8"];
  { rank=same; e4_rn0; e4_hn0; e4_rn1; e4_rn2; }
  e4_rn0 -> e4_hn0 -> e4_rn1 -> e4_rn2 [style=invis, weight=100];
  e4_rn1 -> e4_hn0 [constraint=false, color="#d97706", fontcolor="#d97706", xlabel="SnpResp(I)\nRN1 → XP10 → XP11 → HN0"];
  e5_rn0 [shape=point, group="rn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e5_hn0 [shape=point, group="hn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e5_rn1 [shape=point, group="rn1", width=0.055, height=0.055, label="", color="#94a3b8"];
  e5_rn2 [shape=point, group="rn2", width=0.055, height=0.055, label="", color="#94a3b8"];
  { rank=same; e5_rn0; e5_hn0; e5_rn1; e5_rn2; }
  e5_rn0 -> e5_hn0 -> e5_rn1 -> e5_rn2 [style=invis, weight=100];
  e5_rn2 -> e5_hn0 [constraint=false, color="#d97706", fontcolor="#d97706", xlabel="SnpResp(I)\nRN2 → XP01 → XP11 → HN0"];
  e6_rn0 [shape=point, group="rn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e6_hn0 [shape=point, group="hn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e6_rn1 [shape=point, group="rn1", width=0.055, height=0.055, label="", color="#94a3b8"];
  e6_rn2 [shape=point, group="rn2", width=0.055, height=0.055, label="", color="#94a3b8"];
  { rank=same; e6_rn0; e6_hn0; e6_rn1; e6_rn2; }
  e6_rn0 -> e6_hn0 -> e6_rn1 -> e6_rn2 [style=invis, weight=100];
  e6_hn0 -> e6_rn0 [constraint=false, color="#c026d3", fontcolor="#c026d3", xlabel="CompData(UC)\nHN0 → XP11 → XP01 → XP00 → RN0"];
  e7_rn0 [shape=point, group="rn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e7_hn0 [shape=point, group="hn0", width=0.055, height=0.055, label="", color="#94a3b8"];
  e7_rn1 [shape=point, group="rn1", width=0.055, height=0.055, label="", color="#94a3b8"];
  e7_rn2 [shape=point, group="rn2", width=0.055, height=0.055, label="", color="#94a3b8"];
  { rank=same; e7_rn0; e7_hn0; e7_rn1; e7_rn2; }
  e7_rn0 -> e7_hn0 -> e7_rn1 -> e7_rn2 [style=invis, weight=100];
  e7_rn0 -> e7_hn0 [constraint=false, color="#d97706", fontcolor="#d97706", xlabel="CompAck\nRN0 → XP00 → XP10 → XP11 → HN0"];
  h_rn0 -> e1_rn0 -> e2_rn0 -> e3_rn0 -> e4_rn0 -> e5_rn0 -> e6_rn0 -> e7_rn0 [color="#cbd5e1", style=dashed, arrowhead=none, penwidth=1.0, weight=1000];
  h_hn0 -> e1_hn0 -> e2_hn0 -> e3_hn0 -> e4_hn0 -> e5_hn0 -> e6_hn0 -> e7_hn0 [color="#cbd5e1", style=dashed, arrowhead=none, penwidth=1.0, weight=1000];
  h_rn1 -> e1_rn1 -> e2_rn1 -> e3_rn1 -> e4_rn1 -> e5_rn1 -> e6_rn1 -> e7_rn1 [color="#cbd5e1", style=dashed, arrowhead=none, penwidth=1.0, weight=1000];
  h_rn2 -> e1_rn2 -> e2_rn2 -> e3_rn2 -> e4_rn2 -> e5_rn2 -> e6_rn2 -> e7_rn2 [color="#cbd5e1", style=dashed, arrowhead=none, penwidth=1.0, weight=1000];
  note [shape=note, style=filled, fillcolor="#f8fafc", color="#94a3b8", label="Vertical order is committed model causality, not a clock scale.\nXP names in message labels are the resolved packet route."];
  e7_rn2 -> note [style=invis, weight=1];
}
