  { rank=same; p5_dma; p5_crossbar; p5_sensor; p5_memory; }
  p5_dma -> p5_crossbar -> p5_sensor -> p5_memory [style=invis, weight=100];
  p5_dma -> p5_crossbar [constraint=false, penwidth=1.6, color="#2563eb", fontcolor="#2563eb", label="e5 W 0x10203040"];
  p6_dma [shape=point, width=0.035, label="", color="#94a3b8", group="dma"];
  p5_dma -> p6_dma [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p6_crossbar [shape=point, width=0.035, label="", color="#94a3b8", group="crossbar"];
  p5_crossbar -> p6_crossbar [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p6_sensor [shape=point, width=0.035, label="", color="#94a3b8", group="sensor"];
  p5_sensor -> p6_sensor [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p6_memory [shape=point, width=0.035, label="", color="#94a3b8", group="memory"];
  p5_memory -> p6_memory [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  { rank=same; p6_dma; p6_crossbar; p6_sensor; p6_memory; }
  p6_dma -> p6_crossbar -> p6_sensor -> p6_memory [style=invis, weight=100];
  p6_crossbar -> p6_memory [constraint=false, penwidth=1.6, color="#2563eb", fontcolor="#2563eb", label="e6 AW 0x0"];
  p7_dma [shape=point, width=0.035, label="", color="#94a3b8", group="dma"];
  p6_dma -> p7_dma [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p7_crossbar [shape=point, width=0.035, label="", color="#94a3b8", group="crossbar"];
  p6_crossbar -> p7_crossbar [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p7_sensor [shape=point, width=0.035, label="", color="#94a3b8", group="sensor"];
  p6_sensor -> p7_sensor [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p7_memory [shape=point, width=0.035, label="", color="#94a3b8", group="memory"];
  p6_memory -> p7_memory [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  { rank=same; p7_dma; p7_crossbar; p7_sensor; p7_memory; }
  p7_dma -> p7_crossbar -> p7_sensor -> p7_memory [style=invis, weight=100];
  p7_crossbar -> p7_memory [constraint=false, penwidth=1.6, color="#2563eb", fontcolor="#2563eb", label="e7 W 0x10203040"];
  p8_dma [shape=point, width=0.035, label="", color="#94a3b8", group="dma"];
  p7_dma -> p8_dma [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p8_crossbar [shape=point, width=0.035, label="", color="#94a3b8", group="crossbar"];
