digraph "chi_flow_dirty-peer-clean-unique" {
  graph [rankdir=LR, bgcolor="white", pad=0.28, nodesep=0.42, ranksep=0.72, splines=polyline, labelloc="t", label="CleanUnique: absorb a shared-dirty peer through DAT\nresolved SystemProtocol topology", fontname="sans-serif", fontsize=16];
  node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=10, margin="0.13,0.08"];
  edge [fontname="sans-serif", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.62];
  "rn0" [label="RN0\nrequester\nNodeID 0x7", fillcolor="#dbeafe", color="#2563eb"];
  "rn1" [label="RN1\nsnoopee\nNodeID 0x8", fillcolor="#dcfce7", color="#16a34a"];
  "hn0" [label="HN0\nhome\nNodeID 0x21", fillcolor="#ffedd5", color="#ea580c"];
  "xp0" [label="XP0\nrouting forwarder (XP abstraction)", fillcolor="#ede9fe", color="#7c3aed"];
  "rn0" -> "xp0" [label="rn0_to_xp\ntransport · REQ/RSP", tooltip="rn0.tx_to_xp → xp0.from_rn0"];
  "hn0" -> "xp0" [label="hn0_to_xp\ntransport · RSP/SNP", tooltip="hn0.tx_to_xp → xp0.from_hn0"];
  "xp0" -> "rn0" [label="xp_to_rn0\ntransport · RSP", tooltip="xp0.to_rn0 → rn0.rx_from_xp"];
  "xp0" -> "hn0" [label="xp_to_hn0\ntransport · REQ/RSP/DAT", tooltip="xp0.to_hn0 → hn0.rx_from_xp"];
  "rn1" -> "xp0" [label="rn1_to_xp\ntransport · RSP/DAT", tooltip="rn1.tx_to_xp → xp0.from_rn1"];
  "xp0" -> "rn1" [label="xp_to_rn1\ntransport · SNP", tooltip="xp0.to_rn1 → rn1.rx_from_xp"];
  evidence [shape=note, style="filled", fillcolor="#f8fafc", color="#94a3b8", fontsize=8, label="4 VirtualDuts · 6 declared connections\nsolid arrows come from resolved construction\n1 XP-like forwarding abstraction is shown explicitly\nflow time-space omits per-hop transport MOVE events"];
}
