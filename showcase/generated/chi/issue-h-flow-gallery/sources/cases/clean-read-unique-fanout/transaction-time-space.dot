  point_3_0 [shape=point, width=0.07, height=0.07, group="lifeline_3", fixedsize=true, color="#64748b", label=""];
  { rank=same; time_0; point_0_0; point_1_0; point_2_0; point_3_0; }
  time_0 -> point_0_0 -> point_1_0 -> point_2_0 -> point_3_0 [style=invis, weight=100];
  time_1 [shape=plaintext, group="time", label="model_step 36"];
