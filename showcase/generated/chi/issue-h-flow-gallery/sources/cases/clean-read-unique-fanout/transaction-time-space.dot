  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="5" CELLPADDING="2"><TR><TD><B>Legend</B></TD><TD BORDER="1" COLOR="#2563a8" BGCOLOR="#2563a8" WIDTH="12"></TD><TD ALIGN="LEFT">REQ · request</TD><TD BORDER="1" COLOR="#c46a00" BGCOLOR="#c46a00" WIDTH="12"></TD><TD ALIGN="LEFT">SNP · snoop</TD><TD BORDER="1" COLOR="#247148" BGCOLOR="#247148" WIDTH="12"></TD><TD ALIGN="LEFT">RSP · response/credit</TD><TD BORDER="1" COLOR="#7c4aa5" BGCOLOR="#7c4aa5" WIDTH="12"></TD><TD ALIGN="LEFT">DAT · data/copyback</TD><TD BORDER="1" COLOR="#a87d21" BGCOLOR="#fff7dd" WIDTH="12"></TD><TD ALIGN="LEFT">state change</TD></TR></TABLE>>];
  boundary [shape=note, color="#777777", label="Semantic event position only\nnot pins, cycles, or RTL timing"];
  { rank=same; legend; boundary; }
  point_0_7 -> legend [style=invis, minlen=1];
