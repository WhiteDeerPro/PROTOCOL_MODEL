digraph chi_routed_lineage {
  rankdir=TB;
  graph [bgcolor="white", pad=0.35, nodesep=0.35, ranksep=0.42, splines=line, labelloc="t", fontsize=16, label="Committed lineage · request to completion"];
  node [fontname="monospace", fontsize=10, shape=box, style="rounded,filled", margin="0.10,0.06"];
  edge [color="#64748b", penwidth=1.5];
  event0 [fillcolor="#dbeafe", color="#2563eb", label="E0 · sensor_reader.reads.issue"];
  event1 [fillcolor="#ecfdf5", color="#059669", label="E1 · req_0_rn_to_xp0@2"];
  event0 -> event1;
  event2 [fillcolor="#ecfdf5", color="#059669", label="E2 · req_1_xp0_to_xp1@3"];
  event1 -> event2;
  event3 [fillcolor="#ecfdf5", color="#059669", label="E3 · req_2_xp1_to_home@4"];
  event2 -> event3;
  event4 [fillcolor="#ffedd5", color="#ea580c", label="E4 · sensor_io_home.service"];
  event3 -> event4;
  event5 [fillcolor="#f3e8ff", color="#9333ea", label="E5 · dat_0_home_to_xp1@5"];
  event4 -> event5;
  event6 [fillcolor="#f3e8ff", color="#9333ea", label="E6 · dat_1_xp1_to_xp0@6"];
  event5 -> event6;
  event7 [fillcolor="#f3e8ff", color="#9333ea", label="E7 · dat_2_xp0_to_rn@7"];
  event6 -> event7;
  event8 [fillcolor="#dbeafe", color="#2563eb", label="E8 · sensor_reader.reads.complete"];
  event7 -> event8;
  boundary [shape=note, fontname="sans-serif", fillcolor="#f8fafc", color="#64748b", label="Labels are produced by the executed lineage sidecar.
They prove model-level causal custody, not physical timing."];
  event8 -> boundary [style=dashed, color="#94a3b8"];
}
