digraph transaction_causality {
  rankdir=TB;
  label="Clean ReadUnique: two-peer fanout and response join · explicit causality";
  labelloc="t";
  graph [bgcolor="white", nodesep=0.45, ranksep=0.72, splines=polyline, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#3169a8", fontname="sans-serif", fontsize=10];
  edge [color="#3169a8", fontname="sans-serif", fontsize=9];
  event_0 [label="[model_step 0] coherence/transaction state\nrn0: I → I T12 R12:init\nevent=000:rn0 · op=h21:t12\nrn0"];
  event_1 [label="[model_step 36] ReadUnique\nreq · req\nT12 AR1\nevent=message:00 · op=h21:t12\nrn0 → hn0"];
  event_2 [label="[model_step 65] SnpUnique\nsnp · snp\nT100\nevent=message:01 · op=h21:t12\nhn0 → rn1"];
  event_3 [label="[model_step 85] SnpUnique\nsnp · snp\nT100\nevent=message:02 · op=h21:t12\nhn0 → rn2"];
  event_4 [label="[model_step 97] SnpResp\nrsp · rsp\nT100 RI\nevent=message:03 · op=h21:t12\nrn1 → hn0"];
  event_5 [label="[model_step 116] SnpResp\nrsp · rsp\nT100 RI\nevent=message:04 · op=h21:t12\nrn2 → hn0"];
  event_6 [label="[model_step 144] CompData\ndat · dat\nT12 D200 RUC\nevent=message:05 · op=h21:t12\nhn0 → rn0"];
  event_7 [label="[model_step 172] CompAck\nrsp · rsp\nT200 R0\nevent=message:06 · op=h21:t12\nrn0 → hn0"];
  event_0 -> event_1 [label="local issue emits"];
  event_1 -> event_2 [label="participant emits"];
  event_1 -> event_3 [label="participant emits"];
  event_2 -> event_4 [label="participant emits"];
  event_3 -> event_5 [label="participant emits"];
  event_5 -> event_6 [label="Home Snoop-response join"];
  event_6 -> event_7 [label="participant emits"];
  event_4 -> event_6 [label="Home Snoop-response join"];
  boundary [shape=note, fillcolor="white", color="#777777", label="Edges are supplied evidence\ntime proximity does not infer causality"];
}
