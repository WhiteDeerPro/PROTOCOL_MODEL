digraph "chi_flow_clean-evict-retry" {
  graph [rankdir=LR, bgcolor="white", pad=0.28, nodesep=0.42, ranksep=0.72, splines=polyline, labelloc="t", label="Clean Evict retry, P-Credit and credited reissue\nresolved SystemProtocol topology", fontname="sans-serif", fontsize=16];
  node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=10, margin="0.13,0.08"];
  edge [fontname="sans-serif", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.62];
  "rn0" [label="RN0\nrequester\nNodeID 0x7", fillcolor="#dbeafe", color="#2563eb"];
  "hn0" [label="HN0\nhome\nNodeID 0x21", fillcolor="#ffedd5", color="#ea580c"];
  "xp0" [label="XP0\nrouting forwarder (XP abstraction)", fillcolor="#ede9fe", color="#7c3aed"];
  "rn0" -> "xp0" [label="rn0_to_xp_req\ntransport · REQ", tooltip="rn0.tx_req → xp0.from_rn0"];
  "xp0" -> "hn0" [label="xp_to_hn0_req\ntransport · REQ", tooltip="xp0.to_hn0 → hn0.rx_req"];
  "hn0" -> "xp0" [label="hn0_to_xp_rsp\ntransport · RSP", tooltip="hn0.tx_rsp → xp0.from_hn0"];
  "xp0" -> "rn0" [label="xp_to_rn0_rsp\ntransport · RSP", tooltip="xp0.to_rn0 → rn0.rx_rsp"];
  evidence [shape=note, style="filled", fillcolor="#f8fafc", color="#94a3b8", fontsize=8, label="3 VirtualDuts · 4 declared connections\nsolid arrows come from resolved construction\n1 XP-like forwarding abstraction is shown explicitly\nflow time-space omits per-hop transport MOVE events"];
}
