  note [shape=note, style="rounded,filled", fillcolor="#fff7ed", color="#ea580c", label="Selection result: id 11 (p1) before id 40 (p7)
Next delivery waits for explicit EOI"];
  p7_controller -> note [style=dashed, color="#ea580c"];
}
