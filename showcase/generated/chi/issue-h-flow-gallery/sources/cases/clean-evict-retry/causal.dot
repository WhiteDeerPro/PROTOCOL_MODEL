digraph transaction_causality {
  rankdir=TB;
  label="Clean Evict retry, P-Credit and credited reissue · explicit causality";
  labelloc="t";
  graph [bgcolor="white", nodesep=0.45, ranksep=0.72, splines=polyline, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#3169a8", fontname="sans-serif", fontsize=10];
  edge [color="#3169a8", fontname="sans-serif", fontsize=9];
  event_0 [label="[model_step 0] coherence/transaction state\nrn0: UC → I T31 R31:init\nevent=000:rn0 · op=h21:t31\nrn0"];
  event_1 [label="[model_step 20] Evict\nreq · req\nT31 AR1\nevent=message:00 · op=h21:t31\nrn0 → hn0"];
  event_2 [label="[model_step 26] coherence/transaction state\nhn0: D:U7 RD1 Bv0 → D:U7 PR1 Bv0\nevent=026:hn0 · op=h21:t31\nhn0"];
  event_3 [label="[model_step 38] RetryAck\nrsp · rsp\nT31 P5\nevent=message:01 · op=h21:t31\nhn0 → rn0"];
  event_4 [label="[model_step 49] PCrdGrant\nrsp · rsp\nT0 P5\nevent=message:02 · op=h21:t31\nhn0 → rn0"];
  event_5 [label="[model_step 54] coherence/transaction state\nrn0: I T31 R31:wait-credit → I T31 R31:retry-flight\nevent=054:rn0 · op=h21:t31\nrn0"];
  event_6 [label="[model_step 70] Evict\nreq · req\nT31 P5 AR0\nevent=message:03 · op=h21:t31\nrn0 → hn0"];
  event_7 [label="[model_step 86] Comp\nrsp · rsp\nT31 D0 RI\nevent=message:04 · op=h21:t31\nhn0 → rn0"];
  event_0 -> event_1 [label="local issue emits"];
  event_1 -> event_3 [label="participant emits"];
  event_2 -> event_4 [label="local issue emits"];
  event_5 -> event_6 [label="local issue emits"];
  event_6 -> event_7 [label="participant emits"];
  event_1 -> event_2 [label="Retry debt enables P-Credit"];
  event_3 -> event_6 [label="RetryAck observed"];
  event_4 -> event_6 [label="P-Credit enables reissue"];
  boundary [shape=note, fillcolor="white", color="#777777", label="Edges are supplied evidence\ntime proximity does not infer causality"];
}
