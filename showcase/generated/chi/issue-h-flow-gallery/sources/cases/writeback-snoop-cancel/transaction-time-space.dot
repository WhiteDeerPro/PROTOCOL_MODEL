  time_header [shape=plaintext, group="time", label="time"];
  lifeline_0 [shape=box, style="rounded,filled", group="lifeline_0", fillcolor="#eef5ff", color="#3169a8", label="RN0 · old dirty owner\nrequester · rn0\nNodeID=0x7"];
  lifeline_1 [shape=box, style="rounded,filled", group="lifeline_1", fillcolor="#eef5ff", color="#3169a8", label="HN0 · Home\nhome · hn0\nNodeID=0x21"];
