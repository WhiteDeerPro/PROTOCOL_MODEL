digraph transaction_causality {
  rankdir=TB;
  label="Dirty WriteBackFull canceled by pre-response same-line Snoop · explicit causality";
  labelloc="t";
  graph [bgcolor="white", nodesep=0.45, ranksep=0.72, splines=polyline, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#3169a8", fontname="sans-serif", fontsize=10];
  edge [color="#3169a8", fontname="sans-serif", fontsize=9];
  event_0 [label="[model_step 0] coherence/transaction state\nrn0: UD → UD CB31:live\nevent=000:rn0 · op=h21:t31\nrn0"];
  event_1 [label="[model_step 1] coherence/transaction state\nrn1: - → - T32\nevent=001:rn1 · op=h21:t32\nrn1"];
  event_2 [label="[model_step 2] CleanUnique\nreq · req\nT32 AR1\nevent=message:00 · op=h21:t32\nrn1 → hn0"];
  event_3 [label="[model_step 3] SnpCleanInvalid\nsnp · snp\nT100\nevent=message:01 · op=h21:t32\nhn0 → rn0"];
  event_4 [label="[model_step 3] coherence/transaction state\nrn0: UD CB31:live → I CB31:cancel\nevent=003:rn0 · op=h21:t32\nrn0"];
  event_5 [label="[model_step 4] SnpRespData\ndat · dat\nT100 D0 RI_PD\nevent=message:02 · op=h21:t32\nrn0 → hn0"];
  event_6 [label="[model_step 5] Comp\nrsp · rsp\nT32 D200 RUC\nevent=message:03 · op=h21:t32\nhn0 → rn1"];
  event_7 [label="[model_step 6] CompAck\nrsp · rsp\nT200 R0\nevent=message:04 · op=h21:t32\nrn1 → hn0"];
  event_8 [label="[model_step 7] WriteBackFull\nreq · req\nT31 AR1\nevent=message:05 · op=h21:t31\nrn0 → hn0"];
  event_9 [label="[model_step 8] CompDBIDResp\nrsp · rsp\nT31 D201 R0\nevent=message:06 · op=h21:t31\nhn0 → rn0"];
  event_10 [label="[model_step 9] CopyBackWrData\ndat · dat\nT201 RI BE0\nevent=message:07 · op=h21:t31\nrn0 → hn0"];
  event_0 -> event_8 [label="local issue emits"];
  event_1 -> event_2 [label="local issue emits"];
  event_2 -> event_3 [label="participant emits"];
  event_3 -> event_5 [label="participant emits"];
  event_5 -> event_6 [label="Home Snoop-response join"];
  event_6 -> event_7 [label="participant emits"];
  event_8 -> event_9 [label="participant emits"];
  event_9 -> event_10 [label="participant emits"];
  event_4 -> event_9 [label="same-line cancel selects response"];
  boundary [shape=note, fillcolor="white", color="#777777", label="Edges are supplied evidence\ntime proximity does not infer causality"];
}
