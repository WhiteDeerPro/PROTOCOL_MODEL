digraph virtual_dut_structure {
  rankdir=TB;
  label="ahb_to_apb · VirtualDut · constructed";
  labelloc="t";
  graph [bgcolor="white", pad=0.25, nodesep=0.28, ranksep=0.62, splines=polyline, newrank=true];
  node [fontname="sans-serif", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff"];
  edge [fontname="sans-serif", fontsize=9, color="#52606d"];
  subgraph cluster_virtual_dut {
    label="VirtualDut boundary";
    color="#64748b";
    penwidth=1.4;
    style="rounded";
    component_0 [shape=box, fillcolor="#dbeafe", color="#2563eb", penwidth=1.5, label="s_ahb\ninterface port\ninterface: ahb_lite · subordinate", tooltip="s_ahb\ninterface port\ninterface: ahb_lite · subordinate"];
    component_1 [shape=box, fillcolor="#dbeafe", color="#2563eb", penwidth=1.5, label="m_apb\ninterface port\ninterface: apb4 · requester", tooltip="m_apb\ninterface port\ninterface: apb4 · requester"];
    component_2 [shape=box, fillcolor="#e0f2fe", color="#0284c7", penwidth=1.0, label="address completer\nattachment\nbinding: ahb_lite · subordinate", tooltip="address completer\nattachment\nbinding: ahb_lite · subordinate"];
    component_3 [shape=box, fillcolor="#cffafe", color="#0891b2", penwidth=1.0, label="address-access\noperation adapter", tooltip="address-access\noperation adapter"];
    component_4 [shape=box, fillcolor="#e0f2fe", color="#0284c7", penwidth=1.0, label="address requester\nattachment\nbinding: apb4 · requester", tooltip="address requester\nattachment\nbinding: apb4 · requester"];
    component_5 [shape=box, fillcolor="#fae8ff", color="#c026d3", penwidth=1.0, label="typed translation\npipeline: decode protection\n→ address route\n→ target shape\n→ encode protection", tooltip="typed translation\npipeline: decode protection\n→ address route\n→ target shape\n→ encode protection"];
    component_6 [shape=box, fillcolor="#ede9fe", color="#7c3aed", penwidth=1.0, label="serial scheduler\nparent capacity: 8\nchild issue: one at a time", tooltip="serial scheduler\nparent capacity: 8\nchild issue: one at a time"];
    component_7 [shape=box, fillcolor="#ffedd5", color="#ea580c", penwidth=1.0, label="child owner table\ncompletion: child → parent fold", tooltip="child owner table\ncompletion: child → parent fold"];
    { rank=source; component_0; }
    { rank=sink; component_1; }
    component_0 -> component_2 [style=solid, constraint=true, weight=4, color="#475569", label="request"];
    component_2 -> component_3 [style=solid, constraint=true, weight=4, color="#475569", label="AddressAccess"];
    component_4 -> component_1 [style=solid, constraint=true, weight=4, color="#475569", label="request"];
    component_3 -> component_5 [style=solid, constraint=true, weight=4, color="#475569", label=""];
    component_5 -> component_6 [style=solid, constraint=true, weight=4, color="#475569", label="children"];
    component_6 -> component_7 [style=solid, constraint=true, weight=4, color="#475569", label=""];
    component_7 -> component_4 [style=solid, constraint=true, weight=4, color="#475569", label="request"];
  }
}
