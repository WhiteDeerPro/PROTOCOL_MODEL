digraph virtual_dut_structure {
  rankdir=LR;
  label="queued_memory · VirtualDut · constructed";
  labelloc="t";
  graph [bgcolor="white", pad=0.25, nodesep=0.28, ranksep=0.62, splines=polyline, newrank=true];
  node [fontname="sans-serif", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff"];
  edge [fontname="sans-serif", fontsize=9, color="#52606d"];
  subgraph cluster_virtual_dut {
    label="VirtualDut boundary";
    color="#64748b";
    penwidth=1.4;
    style="rounded";
    component_0 [shape=box, fillcolor="#dbeafe", color="#2563eb", penwidth=1.5, label="apb\ninterface port\ninterface: apb4 · completer", tooltip="apb\ninterface port\ninterface: apb4 · completer"];
    component_1 [shape=box, fillcolor="#e0f2fe", color="#0284c7", penwidth=1.0, label="address completer\nattachment\nbinding: apb4 · completer", tooltip="address completer\nattachment\nbinding: apb4 · completer"];
    component_2 [shape=box, fillcolor="#fef3c7", color="#d97706", penwidth=1.0, label="complete-request FIFO\ncapacity: 2", tooltip="complete-request FIFO\ncapacity: 2"];
    component_3 [shape=box, fillcolor="#ede9fe", color="#7c3aed", penwidth=1.0, label="delay / service controller\nfsm: DELAYING → READY → service", tooltip="delay / service controller\nfsm: DELAYING → READY → service"];
    component_4 [shape=box, fillcolor="#dcfce7", color="#16a34a", penwidth=1.0, label="address access handler\nregions: ram@0x1000+0x100", tooltip="address access handler\nregions: ram@0x1000+0x100"];
    component_0 -> component_1 [style=solid, constraint=true, weight=4, color="#475569", label="request"];
    component_1 -> component_2 [style=solid, constraint=true, weight=4, color="#475569", label="complete access"];
    component_2 -> component_3 [style=solid, constraint=true, weight=4, color="#475569", label="ready head"];
    component_3 -> component_4 [style=solid, constraint=true, weight=4, color="#475569", label="execute"];
  }
}
