  point_1_7 [shape=point, width=0.10, height=0.10, group="lifeline_1", fixedsize=true, color="#a87d21", fillcolor="#fff7dd", style=filled, fontname="sans-serif", fontcolor="#7a5410", fontsize=8, label="", xlabel="D:U7 Bv0", tooltip="clean-read-unique-fanout:state:172:hn0: hn0: D:S8,9 P1 Bv0 → D:U7 Bv0"];
  point_2_7 [shape=point, width=0.07, height=0.07, group="lifeline_2", fixedsize=true, color="#64748b", label=""];
