  p8_dma -> p8_crossbar -> p8_sensor -> p8_memory [style=invis, weight=100];
  p8_memory -> p8_crossbar [constraint=false, penwidth=1.6, color="#059669", fontcolor="#059669", label="e8 B OKAY"];
  p9_dma [shape=point, width=0.035, label="", color="#94a3b8", group="dma"];
  p8_dma -> p9_dma [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p9_crossbar [shape=point, width=0.035, label="", color="#94a3b8", group="crossbar"];
  p8_crossbar -> p9_crossbar [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p9_sensor [shape=point, width=0.035, label="", color="#94a3b8", group="sensor"];
  p8_sensor -> p9_sensor [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  p9_memory [shape=point, width=0.035, label="", color="#94a3b8", group="memory"];
  p8_memory -> p9_memory [arrowhead=none, color="#cbd5e1", penwidth=1.0, weight=1000];
  { rank=same; p9_dma; p9_crossbar; p9_sensor; p9_memory; }
  p9_dma -> p9_crossbar -> p9_sensor -> p9_memory [style=invis, weight=100];
  p9_crossbar -> p9_dma [constraint=false, penwidth=1.6, color="#059669", fontcolor="#059669", label="e9 B OKAY"];
  repeat [shape=note, style="rounded,dashed,filled", fillcolor="#fff7ed", color="#ea580c", label="beat 1 repeats the same read→write lifecycle
with the next retained sample"];
  p9_crossbar -> repeat [style=dashed, color="#ea580c"];
}
