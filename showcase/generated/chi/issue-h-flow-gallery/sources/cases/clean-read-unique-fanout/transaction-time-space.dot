  { rank=same; time_7; point_0_7; point_1_7; point_2_7; point_3_7; }
  time_7 -> point_0_7 -> point_1_7 -> point_2_7 -> point_3_7 [style=invis, weight=100];
  lifeline_0 -> point_0_0 -> point_0_1 -> point_0_2 -> point_0_3 -> point_0_4 -> point_0_5 -> point_0_6 -> point_0_7 [arrowhead=none, style=dashed, color="#94a3b8", weight=20];
