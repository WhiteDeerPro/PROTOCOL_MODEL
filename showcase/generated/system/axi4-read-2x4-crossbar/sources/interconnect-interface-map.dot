digraph interconnect_interface_map {
  rankdir=TB;
  label="AXI4 read-only 2×4 · interface boundary view";
  labelloc="t";
  graph [bgcolor="white", pad=0.28, nodesep=0.5, ranksep=0.72, splines=polyline, ordering=out];
  node [fontname="sans-serif", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", margin="0.14,0.09"];
  edge [fontname="sans-serif", fontsize=8, color="#52606d", penwidth=2.0];
  fabric [shape=plain, id="dut:crossbar", label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" COLOR="#ea580c">
    <TR><TD COLSPAN="4" BGCOLOR="#ffedd5" CELLPADDING="7"><B>crossbar · VirtualDut</B></TD></TR>
    <TR><TD PORT="ingress0" COLSPAN="2" BGCOLOR="#dbeafe" CELLPADDING="6">s0<BR/>subordinate</TD><TD PORT="ingress1" COLSPAN="2" BGCOLOR="#dbeafe" CELLPADDING="6">s1<BR/>subordinate</TD></TR>
    <TR><TD COLSPAN="4" BGCOLOR="#fff7ed" CELLPADDING="8">2 ingress × 4 egress<BR/><FONT POINT-SIZE="9">address route boundary</FONT></TD></TR>
    <TR><TD PORT="egress0" COLSPAN="1" BGCOLOR="#dbeafe" CELLPADDING="6">m0<BR/>manager</TD><TD PORT="egress1" COLSPAN="1" BGCOLOR="#dbeafe" CELLPADDING="6">m1<BR/>manager</TD><TD PORT="egress2" COLSPAN="1" BGCOLOR="#dbeafe" CELLPADDING="6">m2<BR/>manager</TD><TD PORT="egress3" COLSPAN="1" BGCOLOR="#dbeafe" CELLPADDING="6">m3<BR/>manager</TD></TR>
  </TABLE>>];
  ingress_peer0 [id="port:manager0.axi", fillcolor="#eff6ff", color="#2563eb", label="manager0\naxi · manager"];
  ingress_peer0 -> fabric:ingress0:n [dir=none, id="connection:manager0_bus", label="axi4_read_only"];
  ingress_peer1 [id="port:manager1.axi", fillcolor="#eff6ff", color="#2563eb", label="manager1\naxi · manager"];
  ingress_peer1 -> fabric:ingress1:n [dir=none, id="connection:manager1_bus", label="axi4_read_only"];
  egress_peer0 [id="port:target0.axi", fillcolor="#ecfdf5", color="#059669", label="target0\naxi · subordinate\n0x1000..0x10ff → 0x0..0xff"];
  fabric:egress0:s -> egress_peer0 [dir=none, id="connection:target0_bus", label="axi4_read_only"];
  egress_peer1 [id="port:target1.axi", fillcolor="#ecfdf5", color="#059669", label="target1\naxi · subordinate\n0x2000..0x20ff → 0x0..0xff"];
  fabric:egress1:s -> egress_peer1 [dir=none, id="connection:target1_bus", label="axi4_read_only"];
  egress_peer2 [id="port:target2.axi", fillcolor="#ecfdf5", color="#059669", label="target2\naxi · subordinate\n0x3000..0x30ff → 0x0..0xff"];
  fabric:egress2:s -> egress_peer2 [dir=none, id="connection:target2_bus", label="axi4_read_only"];
  egress_peer3 [id="port:target3.axi", fillcolor="#ecfdf5", color="#059669", label="target3\naxi · subordinate\n0x4000..0x40ff → 0x0..0xff"];
  fabric:egress3:s -> egress_peer3 [dir=none, id="connection:target3_bus", label="axi4_read_only"];
  { rank=source; ingress_peer0; ingress_peer1; }
  { rank=sink; egress_peer0; egress_peer1; egress_peer2; egress_peer3; }
  ingress_peer0 -> ingress_peer1 [style=invis, weight=80];
  egress_peer0 -> egress_peer1 [style=invis, weight=80];
  egress_peer1 -> egress_peer2 [style=invis, weight=80];
  egress_peer2 -> egress_peer3 [style=invis, weight=80];
}
