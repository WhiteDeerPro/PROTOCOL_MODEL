digraph chi_ring_star {
  graph [layout=neato, overlap=false, splines=curved, bgcolor="white", pad=0.55, outputorder=edgesfirst, labelloc="t", label="CHI Issue H · nonuniform ring + leaf stars", fontname="sans-serif", fontsize=19];
  node [fontname="sans-serif", fontsize=10, fixedsize=true];
  edge [fontname="sans-serif", fontsize=9];
  r0 [pos="0.0,0.0!", pin=true, shape=box, width=1.35, height=0.80, style="rounded,filled", fillcolor="#ede9fe", color="#7c3aed", label="R0\n1 local endpoint"];
  r1 [pos="4.0,3.0!", pin=true, shape=box, width=1.35, height=0.80, style="rounded,filled", fillcolor="#ede9fe", color="#7c3aed", label="R1\n2 local endpoints"];
  r2 [pos="8.0,0.0!", pin=true, shape=box, width=1.35, height=0.80, style="rounded,filled", fillcolor="#ede9fe", color="#7c3aed", label="R2\n1 local endpoint"];
  r3 [pos="4.0,-3.0!", pin=true, shape=box, width=1.35, height=0.80, style="rounded,filled", fillcolor="#ede9fe", color="#7c3aed", label="R3\ntransit-only"];
  rn [pos="-3.0,0.0!", pin=true, shape=box, fixedsize=false, width=2.08, height=1.06, style="rounded,filled", fillcolor="#dbeafe", color="#2563eb", label="RN\nRN requester\nNodeID 0x07"];
  leaf_a [pos="1.8,6.0!", pin=true, shape=box, fixedsize=false, width=2.08, height=1.06, style="rounded,filled", fillcolor="#f8fafc", color="#64748b", label="leaf_a\ndeclared · idle\nNodeID 0x08"];
  leaf_b [pos="6.2,6.0!", pin=true, shape=box, fixedsize=false, width=2.08, height=1.06, style="rounded,filled", fillcolor="#f8fafc", color="#64748b", label="leaf_b\ndeclared · idle\nNodeID 0x09"];
  hn [pos="11.0,0.0!", pin=true, shape=box, fixedsize=false, width=2.08, height=1.06, style="rounded,filled", fillcolor="#ffedd5", color="#ea580c", label="HN\nHome\nNodeID 0x21"];
  r0 -> r1 [dir=both, color="#94a3b8", penwidth=2.0, arrowsize=0.45];
  r0 -> r3 [dir=both, color="#94a3b8", penwidth=2.0, arrowsize=0.45];
  r1 -> r2 [dir=both, color="#94a3b8", penwidth=2.0, arrowsize=0.45];
  r2 -> r3 [dir=both, color="#94a3b8", penwidth=2.0, arrowsize=0.45];
  rn -> r0 [dir=both, color="#94a3b8", penwidth=1.5, arrowsize=0.42];
  leaf_a -> r1 [dir=both, color="#94a3b8", penwidth=1.5, arrowsize=0.42];
  leaf_b -> r1 [dir=both, color="#94a3b8", penwidth=1.5, arrowsize=0.42];
  hn -> r2 [dir=both, color="#94a3b8", penwidth=1.5, arrowsize=0.42];
  rn -> r0 [constraint=false, color="#2563eb", penwidth=3.1, arrowsize=0.72, label="", fontcolor="#2563eb"];
  r0 -> r1 [constraint=false, color="#2563eb", penwidth=3.1, arrowsize=0.72, label="", fontcolor="#2563eb"];
  r1 -> r2 [constraint=false, color="#2563eb", penwidth=3.1, arrowsize=0.72, label="REQ", fontcolor="#2563eb"];
  r2 -> hn [constraint=false, color="#2563eb", penwidth=3.1, arrowsize=0.72, label="", fontcolor="#2563eb"];
  hn -> r2 [constraint=false, color="#c026d3", penwidth=3.1, arrowsize=0.72, label="", fontcolor="#c026d3"];
  r2 -> r3 [constraint=false, color="#c026d3", penwidth=3.1, arrowsize=0.72, label="", fontcolor="#c026d3"];
  r3 -> r0 [constraint=false, color="#c026d3", penwidth=3.1, arrowsize=0.72, label="DAT", fontcolor="#c026d3"];
  r0 -> rn [constraint=false, color="#c026d3", penwidth=3.1, arrowsize=0.72, label="", fontcolor="#c026d3"];
  legend [pos="4,-5.2!", pin=true, fixedsize=false, shape=plain, label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="8"><TR>
      <TD><FONT COLOR="#2563eb">● REQ path</FONT></TD>
      <TD><FONT COLOR="#c026d3">● DAT return</FONT></TD>
      <TD><FONT COLOR="#94a3b8">● declared bidirectional hop pair</FONT></TD>
    </TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9" COLOR="#475569">
      16 directed hops · 16 exact routes · 4+4 executed hops
    </FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9" COLOR="#475569">
      The leaf cluster is not a shared bus; each line is an explicit point-to-point attachment.
    </FONT></TD></TR></TABLE>
  >];
}
