digraph chi_direct_read {
  rankdir=TB;
  graph [bgcolor="white", pad=0.35, ranksep=0.72, nodesep=1.15, splines=line, outputorder=edgesfirst, labelloc="t", fontsize=16, label="CHI Issue H · direct ReadNoSnp / event-index view"];
  node [fontname="sans-serif", fontsize=10, shape=box, style="rounded,filled", margin="0.10,0.07"];
  edge [fontname="sans-serif", fontsize=9];
  rn_head [group="rn", fillcolor="#dbeafe", color="#2563eb", penwidth=1.6, label="RN-I requester
ledger + TXREQ + RXDAT"];
  home_head [group="home", fillcolor="#ffedd5", color="#ea580c", penwidth=1.6, label="Direct Home
RXREQ + FIFO/service + TXDAT"];
  { rank=same; rn_head; home_head; }
  rn0 [group="rn", color="#2563eb", fillcolor="#eff6ff", label="E0 · allocate TxnID=3\noutstanding 0→1"];
  home0 [group="home", shape=point, width=0.055, height=0.055, color="#ea580c", fillcolor="#ea580c", label=""];
  { rank=same; rn0; home0; }
  rn1 [group="rn", color="#2563eb", fillcolor="#eff6ff", label="E1 · TXREQ receives L-Credit"];
  home1 [group="home", color="#ea580c", fillcolor="#fff7ed", label="E1 · TXDAT receives L-Credit\ncredit usable next frame"];
  { rank=same; rn1; home1; }
  rn2 [group="rn", color="#2563eb", fillcolor="#eff6ff", label="E2 · REQ FIFO 1→0"];
  home2 [group="home", color="#ea580c", fillcolor="#fff7ed", label="E2 · REQ capture 0→1"];
  { rank=same; rn2; home2; }
  rn3 [group="rn", shape=point, width=0.055, height=0.055, color="#2563eb", fillcolor="#2563eb", label=""];
  home3 [group="home", color="#ea580c", fillcolor="#fff7ed", label="E3 · accept request\ndrain REQ capture"];
  { rank=same; rn3; home3; }
  rn4 [group="rn", shape=point, width=0.055, height=0.055, color="#2563eb", fillcolor="#2563eb", label=""];
  home4 [group="home", color="#ea580c", fillcolor="#fff7ed", label="E4 · service FIFO head\nenqueue CompData"];
  { rank=same; rn4; home4; }
  rn5 [group="rn", color="#2563eb", fillcolor="#eff6ff", label="E5 · DAT capture 0→1"];
  home5 [group="home", color="#ea580c", fillcolor="#fff7ed", label="E5 · DAT FIFO 1→0"];
  { rank=same; rn5; home5; }
  rn6 [group="rn", color="#2563eb", fillcolor="#eff6ff", label="E6 · correlate completion\noutstanding 1→0"];
  home6 [group="home", shape=point, width=0.055, height=0.055, color="#ea580c", fillcolor="#ea580c", label=""];
  { rank=same; rn6; home6; }
  rn7 [group="rn", color="#2563eb", fillcolor="#eff6ff", label="E7 · REQ/DAT captures drained"];
  home7 [group="home", color="#ea580c", fillcolor="#fff7ed", label="E7 · both links return to STOP"];
  { rank=same; rn7; home7; }
  rn_head -> home_head [style=invis, weight=80];
  rn_head -> rn0 [style=dashed, color="#94a3b8", arrowhead=none];
  home_head -> home0 [style=dashed, color="#94a3b8", arrowhead=none];
  rn0 -> rn1 [style=dashed, color="#94a3b8", arrowhead=none];
  home0 -> home1 [style=dashed, color="#94a3b8", arrowhead=none];
  rn1 -> rn2 [style=dashed, color="#94a3b8", arrowhead=none];
  home1 -> home2 [style=dashed, color="#94a3b8", arrowhead=none];
  rn2 -> rn3 [style=dashed, color="#94a3b8", arrowhead=none];
  home2 -> home3 [style=dashed, color="#94a3b8", arrowhead=none];
  rn3 -> rn4 [style=dashed, color="#94a3b8", arrowhead=none];
  home3 -> home4 [style=dashed, color="#94a3b8", arrowhead=none];
  rn4 -> rn5 [style=dashed, color="#94a3b8", arrowhead=none];
  home4 -> home5 [style=dashed, color="#94a3b8", arrowhead=none];
  rn5 -> rn6 [style=dashed, color="#94a3b8", arrowhead=none];
  home5 -> home6 [style=dashed, color="#94a3b8", arrowhead=none];
  rn6 -> rn7 [style=dashed, color="#94a3b8", arrowhead=none];
  home6 -> home7 [style=dashed, color="#94a3b8", arrowhead=none];
  rn2 -> home2 [constraint=false, color="#2563eb", penwidth=2.0, xlabel="REQ · ReadNoSnp\nAddr=0x4020 · uses old L-Credit"];
  home5 -> rn5 [constraint=false, color="#ea580c", penwidth=2.0, xlabel="DAT · CompData\nDataID=2 · uses old L-Credit"];
  boundary [shape=note, fillcolor="#f8fafc", color="#64748b", label="event_index shows causal order, not raw RTL cycles\nforward REQ and reverse DAT are independent directed transport links"];
  rn7 -> boundary [style=invis];
  home7 -> boundary [style=invis];
}
